# Copy to .env and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# NOTE: .env is read by the waitlist API and the migration script only. It is
# never bundled into the site — Vite only exposes variables prefixed VITE_, and
# nothing here uses that prefix, so none of these values can reach the browser.

# Neon Postgres — the POOLED connection string, from the Neon console:
#   Project "bravoapp.ai" > Branch "production" > Database "neondb" > Connect
#   Choose "Connection pooling" ON; the host then contains "-pooler".
#
# Format (the password is shown once — copy it from Neon, don't type it here
# from memory):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Port the waitlist API listens on. nginx proxies /api/ to this.
# Only change if 8787 is already taken on the host.
WAITLIST_PORT=8787
