{
  "name": "bravo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "content": "node scripts/build-content.js",
    "content:check": "node scripts/build-content.js --check",
    "images": "node scripts/optimize-images.js",
    "db:migrate": "node --env-file=.env server/migrate.mjs",
    "test:waitlist": "node --test server/*.test.mjs",
    "test:reviews": "node --test server/reviews.test.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "image-size": "^2.0.2",
    "js-yaml": "^5.2.3",
    "markdown-it": "^15.0.0",
    "pg": "^8.13.1",
    "vite": "^5.4.0"
  }
